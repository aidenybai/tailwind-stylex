{
  "name": "tailwind-stylex",
  "version": "0.1.0",
  "description": "Tailwind CSS design tokens for StyleX",
  "keywords": [
    "css",
    "design system",
    "design tokens",
    "stylex",
    "tailwind",
    "tailwindcss"
  ],
  "homepage": "https://github.com/aidenybai/tailwind-stylex#readme",
  "bugs": {
    "url": "https://github.com/aidenybai/tailwind-stylex/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Bai",
    "email": "aiden@million.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidenybai/tailwind-stylex.git"
  },
  "files": [
    "tokens.stylex.d.ts",
    "tokens.stylex.js",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./tokens.stylex": {
      "types": "./tokens.stylex.d.ts",
      "default": "./tokens.stylex.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nr generate:check",
    "generate": "tsx scripts/generate-tokens.ts",
    "generate:check": "tsx scripts/generate-tokens.ts --check",
    "prepack": "cp ../../README.md ../../LICENSE . && nr generate:check",
    "prepublishOnly": "nr build",
    "publint": "nr build && publint",
    "test": "vp test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26",
    "publint": "^0.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@stylexjs/stylex": ">=0.15.0"
  },
  "engines": {
    "node": ">=22"
  }
}
