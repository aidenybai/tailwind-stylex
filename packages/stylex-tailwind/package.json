{
  "name": "stylex-tailwind",
  "version": "0.0.0",
  "description": "Compile Tailwind CSS design tokens and utilities to StyleX",
  "keywords": [
    "css",
    "design system",
    "stylex",
    "tailwind",
    "tailwindcss",
    "utilities"
  ],
  "homepage": "https://github.com/aidenybai/stylex-tailwind#readme",
  "bugs": {
    "url": "https://github.com/aidenybai/stylex-tailwind/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aiden Bai",
    "email": "aiden@million.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidenybai/stylex-tailwind.git"
  },
  "bin": {
    "stylex-tailwind": "./bin/stylex-tailwind.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_ENV=production vp pack",
    "dev": "NODE_ENV=development vp pack --watch",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "nr build",
    "publint": "nr build && publint",
    "test": "vp test"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "publint": "^0.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@stylexjs/stylex": ">=0.15.0",
    "tailwindcss": ">=4.0.0 <5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
